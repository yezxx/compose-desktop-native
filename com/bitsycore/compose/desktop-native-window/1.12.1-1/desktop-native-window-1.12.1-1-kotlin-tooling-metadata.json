{
    "schemaVersion": "1.1.0",
    "buildSystem": "Gradle",
    "buildSystemVersion": "9.7.1",
    "buildPlugin": "org.jetbrains.kotlin.gradle.plugin.KotlinMultiplatformPluginWrapper",
    "buildPluginVersion": "2.4.20",
    "projectSettings": {
        "isHmppEnabled": true,
        "isCompatibilityMetadataVariantEnabled": false,
        "isKPMEnabled": false
    },
    "projectTargets": [
        {
            "target": "org.jetbrains.kotlin.gradle.plugin.mpp.KotlinNativeTarget",
            "platformType": "native",
            "extras": {
                "native": {
                    "konanTarget": "linux_arm64",
                    "konanVersion": "2.4.20",
                    "konanAbiVersion": "2.4.0"
                }
            }
        },
        {
            "target": "org.jetbrains.kotlin.gradle.plugin.mpp.KotlinNativeTargetWithHostTests",
            "platformType": "native",
            "extras": {
                "native": {
                    "konanTarget": "linux_x64",
                    "konanVersion": "2.4.20",
                    "konanAbiVersion": "2.4.0"
                }
            }
        },
        {
            "target": "org.jetbrains.kotlin.gradle.plugin.mpp.KotlinNativeTargetWithHostTests",
            "platformType": "native",
            "extras": {
                "native": {
                    "konanTarget": "macos_arm64",
                    "konanVersion": "2.4.20",
                    "konanAbiVersion": "2.4.0"
                }
            }
        },
        {
            "target": "org.jetbrains.kotlin.gradle.plugin.mpp.KotlinMetadataTarget",
            "platformType": "common"
        }
    ]
}